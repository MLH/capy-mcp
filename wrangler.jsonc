{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "capy-mcp",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-04",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "secrets": { "required": ["CAPY_API_KEY", "MCP_AUTH_TOKEN"] },
  "vars": {
    "CAPY_TOOL_GROUPS": "attachments,automations,captains,files,folders,issues,messages,projects,reviewFilters,reviewRules,reviews,subagents,threads,usage,users",
    "MCP_ALLOWED_ORIGINS": ""
  },
  "observability": {
    "enabled": true,
    "redact_query_string": true,
    "logs": { "enabled": true, "invocation_logs": false },
    "traces": { "enabled": true }
  }
}

{
  "name": "capy-mcp",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "capy-mcp": "dist/stdio.js"
  },
  "files": ["dist/stdio.js"],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsx scripts/build.ts",
    "test": "npm run build && vitest run && npm run test:worker",
    "test:worker": "vitest run --config vitest.workers.config.ts",
    "types:worker": "wrangler types --strict-vars=false",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.workers.json",
    "generate": "tsx scripts/generate.ts",
    "generate:check": "tsx scripts/generate.ts --check",
    "api:refresh": "tsx scripts/refresh-api.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/core": "2.4.0",
    "@modelcontextprotocol/server": "2.4.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.5.1",
    "@modelcontextprotocol/client": "2.4.0",
    "@types/node": "24.10.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "4.1.12",
    "wrangler": "4.157.0"
  }
}
